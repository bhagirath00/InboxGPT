# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Name (defaults to gemini-2.5-flash)
INBOXGPT_MODEL=gemini-2.5-flash

# Google OAuth Keys for Gmail (from Google Cloud Console -> OAuth Client ID)
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret_here

# Alternatively, you can use credentials.json file instead of pasting the two keys above:
# GOOGLE_CLIENT_SECRETS_FILE=path/to/credentials.json

